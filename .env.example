# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=Public"

# Server
PORT=3000

# Set to "production" in any deployment. Required for cross-site auth cookies
# (enables SameSite=None; Secure).
NODE_ENV=development

# JWT
JWT_SECRET="your_jwt_secret"
JWT_EXPIRATION_TIME="1h"

# CORS — comma-separated list of allowed FRONTEND origins (read as CORS_ORIGINS).
# credentials:true forbids "*", so list each origin explicitly.
CORS_ORIGINS="http://localhost:3000"

# COOKIE_DOMAIN — leave UNSET unless frontend and backend share a parent domain
# (e.g. ".example.com"). Must be a bare host: no scheme, port, or path.
# COOKIE_DOMAIN=
